# IAOS MARKETING SITE + LOCAL TOOLING — environment variables
#
# This file documents NAMES AND PURPOSES ONLY. It never carries a value, and it
# never carries a placeholder shaped like a value. Copy it to .env and fill it
# in locally; .env is gitignored.
#
# TWO SECTIONS, AND THE DIVISION IS LOAD-BEARING. Section 1 is a real Netlify
# site environment. Section 2 is a developer machine only and must NEVER be set
# in any Netlify site environment. They are not interchangeable and are kept
# apart rather than merged into one convenient list.
#
# The app site (iaos-app) has its own file: app/.env.example.


# ═══════════════════════════════════════════════════════════════════════════
# SECTION 1 — MARKETING SITE
# Netlify site: investor-automation-os  →  investorautomationos.com
# Repo root; publishes dist/public and serves netlify/functions.
# ═══════════════════════════════════════════════════════════════════════════

# --- Netlify functions (netlify/functions) --------------------------------

# GoHighLevel API token used by phone-lookup and motivation-score.
# NOTE: this site still reads GHL_API_TOKEN. The app site no longer does —
# it requires GHL_PRIVATE_API_KEY with no fallback (Gate 4B-1). Migrating this
# site's credential is a separate, not-yet-authorized item.
GHL_API_TOKEN=

# Twilio account SID. Carrier and line-type lookup (phone-lookup).
TWILIO_ACCOUNT_SID=

# Twilio auth token. Paired with the SID above (phone-lookup).
TWILIO_AUTH_TOKEN=


# --- Browser bundle (client/) ---------------------------------------------
# Baked in by Vite at BUILD time. Changing any of these requires a rebuild.

# OAuth portal base URL.
VITE_OAUTH_PORTAL_URL=

# Application identifier presented to the OAuth portal.
VITE_APP_ID=

# Frontend Forge API key. Used by the map component.
VITE_FRONTEND_FORGE_API_KEY=

# Frontend Forge API base URL. Used by the map component.
VITE_FRONTEND_FORGE_API_URL=


# ═══════════════════════════════════════════════════════════════════════════
# SECTION 2 — LOCAL DEVELOPER TOOLING
#
# NEVER SET ANY OF THESE IN A NETLIFY SITE ENVIRONMENT.
#
# These are read by scripts run by hand on a developer machine. No netlify.toml
# deploys the code that reads them, and nothing in either site's runtime needs
# them. Setting them on a site would place credentials in a deployed
# environment for no operational benefit.
# ═══════════════════════════════════════════════════════════════════════════

# Netlify personal access token. Read by scripts/netlify-status.cjs, the Gate 3
# deployment observer. That script is GET-only, but the TOKEN ITSELF CARRIES
# WRITE AUTHORITY — read-only is a property of the code, not of the credential.
NETLIFY_AUTH_TOKEN=

# Optional override for the GitHub CLI executable path, used by
# scripts/netlify-status.cjs to read the authoritative repo tip. Defaults to
# the standard Windows install location when unset.
NETLIFY_STATUS_GH=

# Origin that app/scripts/verify-proxy-boundary.cjs probes. Defaults to
# PRODUCTION when unset, which is why that harness is excluded from CI. Point
# it at a staging origin before running it unattended.
IAOS_ORIGIN=

# GoHighLevel private integration token, for two local tools:
#   scripts/import-propstream-csv.ts -- creates and updates contacts in bulk
#     from a PropStream CSV. Writes to GHL directly with this token.
#   scripts/rescore-all.ts -- re-scores every contact in the location. Uses this
#     token to enumerate contacts; the score and tag writes are performed by the
#     deployed motivation-score function using its own credential.
# Both cause production writes. Same variable name as the app site's runtime
# credential; this entry exists because those scripts run locally, not because
# the marketing site needs it.
GHL_PRIVATE_API_KEY=
